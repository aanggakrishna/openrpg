FROM python:3.12-slim
WORKDIR /app
COPY online_server.py online_combat.py combat_rules.py pokemon_db.py world_regions.py ./
COPY assets/data/pokedex.sqlite3.gz assets/data/pokedex.sqlite3.gz
RUN useradd --create-home game && mkdir -p /app/.openrpg && chown -R game:game /app
USER game
EXPOSE 8765
CMD ["python", "online_server.py", "--host", "0.0.0.0", "--port", "8765"]
