# Neon Postgres connection string for registration, login and browser saves.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Optional: displayed as the default online-server address in game settings.
# Production Vercel pages use HTTPS; the online server must also be reachable via HTTPS.
NEXT_PUBLIC_ONLINE_SERVER_URL=https://your-online-server.example
